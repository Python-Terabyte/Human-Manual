# ─────────────────────────────────────────────────────────────────────────────
# Neon DB  (https://console.neon.tech → your project → Connection string)
# Use the "pooled" connection string for the API.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Admin SDK  (Firebase Console → Project Settings → Service Accounts
#                     → Generate new private key → download JSON)
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private_key value from the JSON (keep the \n newlines as-is)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────────────────────────────────────────
# Next.js public Firebase config  (Firebase Console → Project Settings → General
#                                  → Your apps → Web app → SDK setup & config)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# ─────────────────────────────────────────────────────────────────────────────
# App URLs
# ─────────────────────────────────────────────────────────────────────────────
# Local dev: http://localhost:3000 (NestJS backend port)
NEXT_PUBLIC_API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
PORT=3000
