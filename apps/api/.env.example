# ─── Neon DB ────────────────────────────────────────────────────────────────
# From: console.neon.tech → your project → Connection string → Pooled connection
DATABASE_URL=postgresql://neondb_owner:xxxx@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─── Firebase Admin ──────────────────────────────────────────────────────────
# From: console.firebase.google.com → Project Settings → Service Accounts
# → Generate new private key → download JSON and extract these values
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkq...\n-----END PRIVATE KEY-----\n"

# ─── App ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001
NODE_ENV=development
PORT=3000
